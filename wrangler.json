{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-bot-clinica",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "wabot-cc80f",
    "FIREBASE_API_KEY": "",
    "DB_PROVIDER": "d1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wabot_coat_db",
      "database_id": "wabot_coat_db_id"
    }
  ]
}
